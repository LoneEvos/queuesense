{
  "name": "queuesense",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "npm install && npm --prefix ingest install && npm --prefix web install",
    "dev": "node scripts/dev.js",
    "tap": "node simulator/send-tap.js",
    "watch": "node simulator/watch-live.js",
    "rush": "node simulator/rush.js",
    "test": "npm --prefix ingest test && node --test \"insights/*.test.js\" \"api/_lib/*.test.js\"",
    "history": "node simulator/history.js"
  },
  "dependencies": {
    "@google-cloud/bigquery": "^7.9.4",
    "express": "^4.21.2",
    "firebase-admin": "^13.0.2"
  },
  "engines": {
    "node": "22.x"
  }
}
