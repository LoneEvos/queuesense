# Copy to .env.local for `npm run dev` against the Firebase emulators.
# Never commit a real salt. In Cloud Run it comes from Secret Manager.
PORT=8081
GOOGLE_CLOUD_PROJECT=demo-queuesense
HASH_SALT=local-dev-salt-change-me-0123456789
SIMULATION_MODE=true
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5000
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
