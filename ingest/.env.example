# Copy to .env.local for `npm run dev` against the Firebase emulators.
# Never commit a real salt. In Cloud Run it comes from Secret Manager.
PORT=8081
GOOGLE_CLOUD_PROJECT=demo-queuesense
HASH_SALT=local-dev-salt-change-me-0123456789
SIMULATION_MODE=true
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5000
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# Optional: Gemini summary on /dispatch. Free key from https://aistudio.google.com/apikey (no billing).
# Leave empty to use the fixed template summary.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash,gemini-3.1-flash-lite,gemini-flash-lite-latest   (tried in order; default has 5)
# AI_PROVIDER=gemini-api   (gemini-api | vertex | template; unset = gemini-api if a key is set, else template)
# For AI_PROVIDER=vertex: VERTEX_PROJECT, VERTEX_LOCATION (default global), VERTEX_SERVICE_ACCOUNT (default FIREBASE_SERVICE_ACCOUNT)
